# Vom Testsatz bei jedem Lauf erzeugt, niemals versionieren.
#
# tests/cookies.txt   enthält ein echtes WordPress-Session-Cookie des
#                     Administrators (wordpress_logged_in_...)
# tests/fixture.json  Nonces sowie Lösch-Token (seit 1.15.0 gibt es nur noch diese)
# tests/*.html        abgelegte Antworten des Adminbereichs mit _wpnonce
tests/cookies.txt
tests/fixture.json
tests/*.html
# tests/mitglieder.csv   wird vom Importabschnitt des Admin-Testlaufs erzeugt
tests/mitglieder.csv
# Der CSV-Abschnitt des Admin-Testlaufs legt die geholte Datei und die Antworten
# der abgelehnten Aufrufe ab. Die geholte Datei enthält echte E-Mail-Adressen der
# Probe-Mitglieder — sie gehören in kein Repository, und schon gar nicht in eines.
tests/export*.csv
tests/export*.txt
# tests/abo*.txt         Anmeldegefäß und Antworten eines WordPress-Kontos ohne
#                        Berechtigung (wordpress_logged_in_... eines Abonnenten)
tests/abo*.txt

# Lieferfertiges Paket, wird aus dem Quellbaum erzeugt, nicht eingecheckt.
# Bauen mit:
#   cd <Projektverzeichnis> && python3 - <<'PY'
#   import os, zipfile
#   files = [
#       os.path.join(b, n)
#       for b, d, ns in os.walk("arbeitsdienste")
#       for n in ns
#       if not n.startswith(".") and not n.endswith((".pyc", ".orig", ".rej"))
#   ]
#   with zipfile.ZipFile("arbeitsdienste.zip", "w", zipfile.ZIP_DEFLATED) as z:
#       for f in sorted(files):
#           z.write(f, f)
#   PY
#   Die Reihenfolge der Einträge ist für WordPress ohne Bedeutung. Maßgeblich
#   ist, dass genau die Dateien des Plugin-Quellbaums enthalten sind, Stand
#   12.10.2026: 25 Dateien, davon 23 PHP. Der Wurzelordner im Paket heißt
#   arbeitsdienste, denn er bestimmt den Ordnernamen nach dem Entpacken und
#   damit den Aktivierungs-Haken.
arbeitsdienste.zip

# Betriebssystem und Editor
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# Vom Gegenproben-Lauf erzeugt: der Soll-Stand, die Logs, das Ergebnis.
tests/gegenproben/.lauf/
